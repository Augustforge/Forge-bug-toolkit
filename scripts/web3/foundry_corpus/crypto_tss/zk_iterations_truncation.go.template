// craftWeakProof — builds a ZK proof with an understated iterations counter.
// Most ZK protocols have a structure where prover generates `t` random
// witnesses, verifier challenges, prover responds. Soundness = 1 - (1/2)^t.
func craftWeakProof(t *testing.T, statement []byte) *tss.ZKProof {
	weakIterations := 1 // instead of 128

	proof := &tss.ZKProof{
		// REPLACE: adjust to the real structure of the target ZK proof
		Iterations: weakIterations,
		Witnesses:  make([][]byte, weakIterations),
		Responses:  make([][]byte, weakIterations),
	}

	for i := 0; i < weakIterations; i++ {
		w := make([]byte, 32)
		rand.Read(w)
		proof.Witnesses[i] = w
		// Adversary knows in advance that 50% of challenges verify.
		// Pre-compute response for the favourable case.
		proof.Responses[i] = computeFavourableResponse(w)
	}
	return proof
}

