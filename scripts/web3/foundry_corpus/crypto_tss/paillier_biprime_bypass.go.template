// generateMalformedPaillier — returns a PaillierSK where N = p*q*r (3 primes),
// not a biprime. This is the main experimental primitive.
func generateMalformedPaillier(t *testing.T) *tss.PaillierPrivateKey {
	// Generate three primes ~684 bits each → N ~2048 bits, looks like
	// biprime by size, but the factorization has 3 factors.
	p, err := rand.Prime(rand.Reader, 684)
	if err != nil {
		t.Fatal(err)
	}
	q, err := rand.Prime(rand.Reader, 684)
	if err != nil {
		t.Fatal(err)
	}
	r, err := rand.Prime(rand.Reader, 680)
	if err != nil {
		t.Fatal(err)
	}

	N := new(big.Int).Mul(p, q)
	N.Mul(N, r)

	// Lambda = lcm(p-1, q-1, r-1) — multi-prime variant
	pm1 := new(big.Int).Sub(p, big.NewInt(1))
	qm1 := new(big.Int).Sub(q, big.NewInt(1))
	rm1 := new(big.Int).Sub(r, big.NewInt(1))

	lambda := new(big.Int).Mul(pm1, qm1)
	lambda.Mul(lambda, rm1)

	return &tss.PaillierPrivateKey{
		// REPLACE: adjust to the real PaillierPrivateKey fields
		// in the target tss-lib (PublicKey.N, Lambda, etc.)
		PublicKey: tss.PaillierPublicKey{N: N},
		Lambda:    lambda,
	}
}

