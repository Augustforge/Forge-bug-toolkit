	// Adversary signs up in keygen with a malformed Paillier key
	malformedKey := generateMalformedPaillier(t)
	parties[advIdx].SetPaillierKey(malformedKey)

	// Run keygen round 1
	keygenResults := make(chan error, len(parties))
	for _, p := range parties {
		go func(p *tss.LocalParty) {
			keygenResults <- p.RunKeygenRound1()
		}(p)
	}

	// Collect results
	rejected := false
	for i := 0; i < len(parties); i++ {
		err := <-keygenResults
		if err != nil && err.Error() == "paillier key not biprime" {
			rejected = true
			t.Logf("[PASS] honest party rejected malformed key: %v", err)
			break
		}
	}

	if !rejected {
		t.Errorf("[BUG] keygen completed without biprime rejection — TSSHOCK class vulnerability present")
		// Next, attempt actual share extraction (Round 2-5)
		// to prove the bug is exploitable, not theoretical.
		extractShareViaMtA(t, parties, advIdx, malformedKey)
	}
}

