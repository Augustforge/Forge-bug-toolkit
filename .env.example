# Copy to .env and fill in your own keys
# Not all of them are required — without some, modules will just print a warning

# ─── GitHub ───────────────────────────────────────────────────────────────────
# https://github.com/settings/tokens — needs scope: public_repo
GITHUB_TOKEN=

# ─── Shodan ───────────────────────────────────────────────────────────────────
# https://account.shodan.io/
SHODAN_API_KEY=

# ─── HaveIBeenPwned (optional) ─────────────────────────────────────────────────
# https://haveibeenpwned.com/API/Key
HIBP_API_KEY=

# ─── HackerOne (optional) ──────────────────────────────────────────────────────
HACKERONE_USERNAME=
HACKERONE_TOKEN=

# ─── Intigriti researcher API (optional, falls back to bounty-targets-data) ───
INTIGRITI_TOKEN=

# ─── Telegram bot (for monitoring system alerts) ──────────────────────────────
# 1. Create a bot: message @BotFather → /newbot
# 2. Get the chat_id: message the bot, then @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Researcher persona (optional, for privacy) ───────────────────────────────
# If set — used in reports instead of your real name
RESEARCHER_HANDLE=
RESEARCHER_EMAIL=

# ─── Additional search engines (optional) ─────────────────────────────────────
# https://fofa.info — better than Shodan for Asian assets
FOFA_EMAIL=
FOFA_KEY=
# https://netlas.io — DNS + HTTP response search
NETLAS_API_KEY=
# https://greynoise.io — filters internet noise
GREYNOISE_API_KEY=
# https://onyphe.io — passive DNS + threat intel
ONYPHE_API_KEY=

# ─── Web3 ─────────────────────────────────────────────────────────────────────

# Etherscan V2 multichain — ONE key works across 60+ EVM networks via chainid.
# V1 deprecated 2025-05-31. The old separate keys (BSCSCAN, POLYGONSCAN, ARBISCAN
# etc.) are no longer needed.
# https://etherscan.io/apis
ETHERSCAN_API_KEY=

# Optional
DEFILLAMA_PRO_KEY=
