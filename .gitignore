# ─── CRITICAL: secrets and findings (never commit!) ───────────────────────────
.env
.env.*
!.env.example

# Sessions contain raw findings, sometimes including credentials of victims.
# Ignore the CONTENTS (not the directory itself — otherwise the re-include below won't work),
# EXCEPT our methodology templates/checklists (not victim data, part of the system).
sessions/*
!sessions/.gitkeep
!sessions/_methodology/
results/

# Local cache (Etherscan source, Immunefi data, TVL snapshots, Twitter feeds)
.bbt/

