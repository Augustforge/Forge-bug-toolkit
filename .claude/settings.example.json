{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "_comment": "Copy to .claude/settings.json. Paths below are relative to the repository root (the folder containing this .claude/). Claude Code runs hooks with the project root as CWD. On Windows replace 'python3' with 'py -3'. These hooks are what turn the methodology from aspiration into enforcement; see SKILL.md section 6.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          { "type": "command", "command": "python3 -X utf8 scripts/hooks/docker_build_reminder.py", "timeout": 15 }
        ]
      },
      {
        "matcher": "Agent|Task|Workflow|Edit|Write",
        "hooks": [
          { "type": "command", "command": "python3 -X utf8 scripts/hooks/model_first_nudge.py", "timeout": 15 }
        ]
      },
      {
        "matcher": "Bash|PowerShell|Grep",
        "hooks": [
          { "type": "command", "command": "python3 -X utf8 scripts/hooks/exposure_scan_nudge.py", "timeout": 15 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Agent|Task|Workflow",
        "hooks": [
          { "type": "command", "command": "python3 -X utf8 scripts/hooks/ledger_first_nudge.py", "timeout": 15 }
        ]
      },
      {
        "matcher": "WebFetch|Agent|Task|Workflow|mcp__.*playwright.*browser",
        "hooks": [
          { "type": "command", "command": "python3 -X utf8 scripts/hooks/prompt_injection_guard.py", "timeout": 15 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "python3 -X utf8 scripts/hooks/hunt_entry_gate.py", "timeout": 15 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "python3 -X utf8 scripts/hooks/hunt_completeness_gate.py", "timeout": 15 }
        ]
      }
    ]
  }
}
